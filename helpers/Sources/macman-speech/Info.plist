<?xml version="1.0" encoding="UTF-8"?>
<!--
  Embedded into the macman-speech binary's __TEXT,__info_plist section.

  Not cosmetic. macOS TCC *terminates* a process that touches privacy-sensitive
  APIs without a usage description — SIGABRT, no prompt, no error message. A
  command-line tool has no bundle to carry one, so it is linked into the
  executable instead.

  This only bites when permission is `notDetermined`: once granted, no prompt is
  needed and the missing key never shows. That is precisely why it survived
  local testing on a Mac where permission had already been granted, and would
  have crashed on every fresh install instead of asking.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.macman.helpers.speech</string>
    <key>CFBundleName</key>
    <string>macman-speech</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>MACman transcribes what you say so you can control this Mac by voice. Speech is processed on-device and is not sent anywhere.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>MACman listens for spoken commands. Audio is processed on-device and is not recorded or uploaded.</string>
</dict>
</plist>
